# Copy this file to .env. The application works offline with these defaults.
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# SQLite is used by default.
# DATABASE_URL=sqlite:///promptshield.db

# Target-model provider. PromptShield's local MockLLMProvider remains the default.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Gemini is the primary semantic detector for /api/analyze.
# Add your key locally; never put it in frontend code or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
LLM_JUDGE_ENABLED=true
LLM_JUDGE_MODE=gemini

# Hybrid detector weights
RULE_WEIGHT=0.35
ML_WEIGHT=0.40
LLM_JUDGE_WEIGHT=0.25

# Risk engine thresholds: SAFE 0-20 / LOW 21-40 / MEDIUM 41-60 / HIGH 61-80 / CRITICAL 81-100
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

DEFAULT_DEFENSE_MODE=standard
ENABLE_API_AUTH=true
DEMO_MODE=true
RATE_LIMIT=100/minute
ENABLE_TLS=false
SSL_CERT_FILE=
SSL_KEY_FILE=
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
ML_BACKEND=tfidf

# Cryptographic and audit settings
HMAC_SECRET=
ENCRYPTION_KEY=
AUDIT_SIGNING_KEY=
CANARY_ENABLED=true
TARGET_SYSTEM_PROMPT=PromptShield simulated protected system context.
